# Runtime config for the container (serve.mjs writes these into config.js at
# startup). Not used by `npm run dev` — that reads public/config.js directly.

# Data-plane URL the browser SDK posts events/replay to.
RT_INGEST_ENDPOINT=http://localhost:4317

# Browser-exposed tenant key (events:write scope only). In a real deployment
# this is a short-lived per-tenant key, not a secret admin token.
RT_PUBLIC_TENANT_KEY=replace-me-with-long-random-string

# Port the container listens on (optional; default 8080).
# PORT=8080
