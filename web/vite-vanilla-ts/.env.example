# Copy to `.env` next to the compose file for Docker — these become CONTAINER
# env, materialized into config.js at startup (nothing is baked at build time).
# For local `npm run dev`, edit public/config.js instead; Vite serves it as-is.
#
# Endpoint the SDK POSTs events to. Defaults to the resolvetrace-core
# docker-compose port.
RT_INGEST_ENDPOINT=http://localhost:4317

# events:write-only tenant key (browser-exposed by design). Must match a key the
# ingest server accepts (see resolvetrace-core's `deploy/docker-compose.yml`).
RT_PUBLIC_TENANT_KEY=replace-me-with-long-random-string
